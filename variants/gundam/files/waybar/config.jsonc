{
  "layer": "top",
  "position": "top",
  "height": 20,
  "spacing": 0,
  "custom/theme": {
    "format": "RX–78  /  E.F.S.F.",
    "tooltip-format": "左键：主题管理\n右键：应用启动器",
    "on-click": "@PACKAGE@/REATheme",
    "on-click-right": "rofi -show drun"
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "persistent-workspaces": {
      "*": 4
    }
  },
  "network": {
    "format-wifi": "LINK {signalStrength:02}%",
    "format-ethernet": "◈ LAN",
    "format-disconnected": "◇ OFF",
    "tooltip-format": "{essid}\n{ipaddr}",
    "on-click": "foot nmtui",
    "interval": 10
  },
  "pulseaudio": {
    "format": "COM {volume:02}",
    "format-muted": "♪ MUTE",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5,
    "tooltip-format": "音量 {volume}% · 滚轮调整 · 点击静音"
  },
  "battery": {
    "format": "BAT {capacity:02}%",
    "format-charging": "+ {capacity}%",
    "format-plugged": "+ {capacity}%",
    "states": {
      "warning": 25,
      "critical": 10
    },
    "tooltip-format": "笔记本电池 {capacity}% · {timeTo}"
  },
  "clock": {
    "format": "{:%H:%M  /  %m.%d}",
    "tooltip-format": "{:%A, %Y-%m-%d}"
  },
  "clock#date": {
    "format": "{:%Y . %m . %d}",
    "tooltip-format": "{:%Y-%m-%d}"
  },
  "cpu": {
    "format": "CPU {usage:02}%",
    "interval": 3,
    "on-click": "foot btop"
  },
  "memory": {
    "format": "MEM {percentage:02}%",
    "interval": 5,
    "on-click": "foot btop"
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 28,
    "separate-outputs": true
  },
  "tray": {
    "spacing": 8,
    "icon-size": 12
  },
  "margin": "0",
  "custom/unit": {
    "format": "E.F.S.F. / MOBILE SUIT",
    "tooltip": false
  },
  "group/designation": {
    "orientation": "horizontal",
    "modules": [
      "custom/theme"
    ]
  },
  "modules-left": [
    "custom/theme",
    "hyprland/workspaces"
  ],
  "group/chronometer": {
    "orientation": "horizontal",
    "modules": [
      "clock"
    ]
  },
  "modules-center": [
    "clock"
  ],
  "group/telemetry": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "memory"
    ]
  },
  "modules-right": [
    "cpu",
    "memory",
    "network",
    "pulseaudio",
    "battery",
    "tray",
    "custom/power"
  ],
  "custom/power": {
    "format": "⏻",
    "tooltip-format": "电源菜单 · Super Shift P\n右键：锁屏 · Super L",
    "on-click": "@PACKAGE@/desktop.py power",
    "on-click-right": "@PACKAGE@/desktop.py lock"
  }
}
