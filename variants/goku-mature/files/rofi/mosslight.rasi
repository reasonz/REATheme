* { bg: #161b22fa; fg: #e4d9c7; accent: #d99e68; muted: #9396a0; background-color: transparent; text-color: @fg; border-radius: 0px; }
window { width: 520px; border: 1px; border-color: #d99e68; background-color: @bg; padding: 24px; }
mainbox { spacing: 20px; }
inputbar { padding: 0px 0px 16px; border: 0px 0px 1px; border-color: #5b4b43; children: [ prompt, entry ]; spacing: 18px; }
prompt { text-color: @accent; }
entry { placeholder: "Search"; placeholder-color: @muted; }
listview { lines: 7; columns: 1; spacing: 4px; fixed-height: true; }
element { padding: 11px 12px; spacing: 12px; }
element selected { background-color: #2c3038; text-color: #e4d9c7; }
element-text { highlight: bold; }
message { padding: 10px; } textbox { text-color: @muted; }
