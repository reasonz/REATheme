* { bg: #181c1cfa; fg: #dedfce; accent: #c7c5ac; muted: #8c9c91; background-color: transparent; text-color: @fg; border-radius: 0px; }
window { width: 520px; border: 1px; border-color: #c7c5ac; background-color: @bg; padding: 24px; }
mainbox { spacing: 20px; }
inputbar { padding: 0px 0px 16px; border: 0px 0px 1px; border-color: #464d48; children: [ prompt, entry ]; spacing: 18px; }
prompt { text-color: @accent; }
entry { placeholder: "Search"; placeholder-color: @muted; }
listview { lines: 7; columns: 1; spacing: 4px; fixed-height: true; }
element { padding: 11px 12px; spacing: 12px; }
element selected { background-color: #2b3031; text-color: #dedfce; }
element-text { highlight: bold; }
message { padding: 10px; } textbox { text-color: @muted; }
